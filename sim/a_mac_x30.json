{
  "name": "A 지금 구성 (맥 k3s 1노드) (30배 압축)",
  "description": "평소 분당 3쪽, 120~220s에 200쪽 철 업로드. OCR Pod 1개가 한 쪽씩 처리(쪽당 9s 실측) · 화면 시각 = 원래 시각 ÷ 30",
  "seconds": 130.0,
  "design": {
    "name": "docflow on mac",
    "nodes": [
      {
        "id": "upload",
        "kind": "client",
        "label": "쪽 업로드",
        "x": 0,
        "y": 200,
        "config": {
          "rps": 1.5,
          "timeoutMs": 66.66666666666667,
          "retries": 0
        }
      },
      {
        "id": "q",
        "kind": "queue",
        "label": "철 대기열 (Pod 메모리)",
        "x": 380,
        "y": 200,
        "config": {
          "serviceMs": 0.03333333333333333,
          "serviceCv": 0.2,
          "queueLimit": 5000
        }
      },
      {
        "id": "ocr",
        "kind": "worker",
        "label": "docflow OCR Pod ×1",
        "x": 760,
        "y": 200,
        "config": {
          "capacity": 1,
          "serviceMs": 300.0,
          "serviceCv": 0.2
        }
      },
      {
        "id": "gpt",
        "kind": "service",
        "label": "GPT (추출·손글씨)",
        "x": 1140,
        "y": 200,
        "config": {
          "capacity": 4,
          "serviceMs": 93.33333333333333,
          "serviceCv": 0.3,
          "queueLimit": 1000,
          "timeoutMs": 0.0,
          "retries": 0
        }
      }
    ],
    "edges": [
      {
        "from": "upload",
        "to": "q"
      },
      {
        "from": "q",
        "to": "ocr"
      },
      {
        "from": "ocr",
        "to": "gpt"
      }
    ]
  },
  "specs": {
    "ocr": {
      "product": "맥 colima 4vCPU/8GB (k3s 1노드)",
      "vcpu": 4,
      "memMiB": 5120,
      "cpuPerReq": 1,
      "memBaseMiB": 2048,
      "memPerInflightMiB": 300
    },
    "gpt": {
      "product": "OpenAI gpt-4.1-mini",
      "managed": true
    }
  },
  "timeline": [
    {
      "at": 4.0,
      "set": {
        "upload": {
          "rps": 60.0
        }
      }
    },
    {
      "at": 7.333333333333333,
      "set": {
        "upload": {
          "rps": 1.5
        }
      }
    }
  ]
}