+def test_lock_min_from_env(monkeypatch):
+    import importlib.util
+    monkeypatch.setenv("LOGIN_LOCK_MIN", "30")
+    spec = importlib.util.spec_from_file_location("auth_copy", auth.__file__)  # app.auth는 건드리지 않고 복사본으로
+    m = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(m)
+    assert m.LOCK_MIN == 30 and auth.LOCK_MIN == 15
